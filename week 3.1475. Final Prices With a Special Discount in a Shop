import java.util.ArrayDeque;
import java.util.Deque;

class Solution {
    public int[] finalPrices(int[] prices) {
        int n = prices.length;
        int[] result = prices.clone(); // Copy original prices as default (no discount)
        Deque<Integer> stack = new ArrayDeque<>(); // Monotonic stack storing indices

        for (int i = 0; i < n; i++) {
            // If the current price is <= the price at stack's top index,
            // then prices[i] is the discount for stack's top index.
            while (!stack.isEmpty() && prices[stack.peek()] >= prices[i]) {
                int prevIndex = stack.pop();
                result[prevIndex] = prices[prevIndex] - prices[i];
            }
            stack.push(i);
        }

        return result;
    }
}
